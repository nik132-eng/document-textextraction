# ─────────────────────────────────────────────────────────────────────────────
# IDP engine POC. Copy to .env and fill in. Never commit .env.
# Synthetic documents only until the BAA gates in docs/MANUAL-SETUP.md are done.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_ROLE=all                 # api | worker | all
PIPELINE_MODE=sync           # sync = run in the request | queue = BullMQ on Redis
LOG_LEVEL=info
PHI_MODE=false               # true = refuse to boot unless every PHI gate is confirmed

# ── Data (docker compose up -d) ─────────────────────────────────────────────
DATABASE_URL=postgresql://idp:idp@localhost:5433/idp_poc
REDIS_URL=redis://localhost:6380
WORKER_CONCURRENCY=2

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local         # local | s3
STORAGE_DIR=./.data
STORAGE_PREFIX=idp-poc/
# S3_BUCKET=
# S3_KMS_KEY_ID=             # alias/idp-dev or key ARN; omitted = bucket default KMS key

MAX_UPLOAD_MB=25
RASTER_DPI=200

# ── Engines: THE SWITCH ─────────────────────────────────────────────────────
# Which adapters exist in this process, and which one runs when a request names none.
# Any subset of: fake,textract,vlmrun,meibel. Each one you enable needs its block below.
ENGINES_ENABLED=fake
ENGINE_DEFAULT=fake
DEFAULT_MIN_CONFIDENCE=80

# ── Amazon Textract ─────────────────────────────────────────────────────────
# No access keys here, ever. The SDK uses the default provider chain:
# locally an IAM Identity Center (SSO) profile, in AWS the ECS task role.
AWS_REGION=us-east-1
AWS_PROFILE=idp-dev
TEXTRACT_MAX_ATTEMPTS=6

# ── VLM Run ─────────────────────────────────────────────────────────────────
VLMRUN_API_KEY=
VLMRUN_BASE_URL=https://api.vlm.run
VLMRUN_MODEL=vlm-1           # pin it; never a third-party model id for PHI
VLMRUN_DETAIL=hi
VLMRUN_POLL_MS=2000
VLMRUN_TIMEOUT_MS=120000
VLMRUN_CONFIDENCE_MAP={"high":95,"medium":75,"low":40}
VLMRUN_BAA_CONFIRMED=false   # Pro plan + signed BAA

# ── Meibel ──────────────────────────────────────────────────────────────────
MEIBEL_API_KEY=
MEIBEL_BASE_URL=https://api.meibel.ai/v2   # BYOC: your data-plane URL
MEIBEL_POLL_MS=2000
MEIBEL_TIMEOUT_MS=300000
MEIBEL_DEFAULT_FIELD_CONFIDENCE=           # empty = no confidence -> every value goes to review
MEIBEL_BAA_CONFIRMED=false                 # signed BAA or approved BYOC
